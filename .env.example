# Variables opcionales del sistema. Copia el contenido en las variables de entorno de Windows
# o modifica INICIAR_ALTIVIA.bat con "set VARIABLE=valor" antes de ejecutar launcher.py.
ALTIVIA_HOST=127.0.0.1
ALTIVIA_PORT=8765
ALTIVIA_COOKIE_SECURE=0
GOOGLE_DRIVE_ROOT_ID=1rOoOcJ9SXHHc9BX6tLHjDIfE2_SqkeA1
GOOGLE_REDIRECT_URI=http://localhost:8765/drive/callback
TESSERACT_LANG=spa+eng
# Optativo: reconocimiento visual avanzado. Requiere una clave API con facturación independiente de ChatGPT Plus.
OPENAI_VISION_ENABLED=0
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
# Si Tesseract no aparece en PATH, indica ruta absoluta a tesseract.exe.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# v4 OCR híbrido (uso opt-in, la API se cobra por separado)
OPENAI_VISION_ENABLED=0
OPENAI_VISION_MODEL=gpt-4.1-mini
ALTIVIA_AI_FALLBACK_MISSING=2
ALTIVIA_AI_TIMEOUT=18
